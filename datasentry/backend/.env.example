# DataSentry Backend Configuration
# Copy to .env and fill in your values.

DATABASE_URL=sqlite:///./datasentry.db
# DATABASE_URL=postgresql://datasentry:datasentry@localhost:5432/datasentry

REDIS_URL=redis://localhost:6379/0
CELERY_EAGER=true

# Security: change this to a random 32+ char string for production
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440

# LLM (Gemini + Groq fallback)
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# Storage
STORAGE_ROOT=./.data
MAX_UPLOAD_MB=200

# Alerts
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=datasentry@localhost

# Misc
ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOW_SIGNUP=true
